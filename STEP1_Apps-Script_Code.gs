// AMBER Kwara 2027 Phone Poll — deployment-safe Google Apps Script backend.
// Pinned to the correct spreadsheet and compatible with the GitHub Pages iframe bridge.

const SPREADSHEET_ID = '1PIEcKV59dS_Fpz-C9iew1RoAIxsXvny78DpfNfMKrC4';
const T = {USERS:'Users',CONTACTS:'Contacts',RESP:'Responses',ATT:'Attempts',SET:'Settings',AUDIT:'Audit',STAGE:'Staging',ERR:'Import errors',UP:'Uploads'};
const UH = ['username','full_name','role','active','pw_hash','must_change','created_at'];
const CH = ['id','name','phone_normalised','phone_original','lga','ward','polling_unit','status','in_directory','created_at'];
const AH = ['id','contact_id','enumerator','started_at','ended_at','disposition'];
const RCOLS = [
['Response ID','id'],['Submitted at','submitted_at'],['Interview date','interview_date'],['Enumerator','_enumerator'],['Enumerator username','_enum_user'],['Status','status'],['Disposition','disposition'],['Call start','call_start'],['Call end','call_end'],['Duration (seconds)','duration_seconds'],['Contact ID','contact_id'],['Language of interview','language'],['Respondent name','respondent_name'],['Phone number','respondent_phone'],['Local government','respondent_lga'],['Ward','respondent_ward'],['Polling unit','respondent_polling_unit'],['Respondent reached','respondent_reached'],['Consent','consent'],['S1 Registration check','s1_registration_check'],['S1 New local government','s1_new_lga'],['S1 New ward','s1_new_ward'],['Voting local government','vote_lga'],['Senate district','senate_district'],['Q1 Rating of Governor AbdulRazaq','q1_governor_rating'],['Q2 Biggest problem in area','q2_biggest_problem'],['Q2 Other','q2_other'],['Q3 Governorship vote','q3_governor_vote'],['Q3 Someone else','q3_other'],['Q3 Rotation','q3_rotation'],['Q4 Mind made up','q4_mind_made_up'],['Q5 Leaning','q5_leaning'],['Q6 Main reason','q6_main_reason'],['Q6 Which leader','q6_leader'],['Q6 Other','q6_other'],['Q7 Heard of Danladi (APC)','q7_known_danladi'],['Q7 Heard of Kawu (PDP)','q7_known_kawu'],['Q7 Heard of Zakari (ADC)','q7_known_zakari'],['Q7 Heard of Apaokagi (SDP)','q7_known_apaokagi'],['Q8 Feeling Danladi (APC)','q8_feeling_danladi'],['Q8 Feeling Kawu (PDP)','q8_feeling_kawu'],['Q8 Feeling Zakari (ADC)','q8_feeling_zakari'],['Q8 Feeling Apaokagi (SDP)','q8_feeling_apaokagi'],['Q9 Senate vote','q9_senate_vote'],['Q9 Someone else','q9_other'],['Q9 Rotation','q9_rotation'],['Q10 Same party in both','q10_same_party'],['Q11 Zoning','q11_zoning'],['Q12 2023 Governor vote','q12_2023_vote'],['Q13 Turnout likelihood','q13_turnout_likelihood'],['Q14 Voter card (PVC)','q14_pvc'],['D1 Religion','d1_religion'],['D2 People or tribe','d2_tribe'],['D2 Other','d2_other']
];
const LGAS={Asa:'Kwara Central','Ilorin East':'Kwara Central','Ilorin South':'Kwara Central','Ilorin West':'Kwara Central',Offa:'Kwara South',Oyun:'Kwara South',Ifelodun:'Kwara South',Irepodun:'Kwara South',Isin:'Kwara South',Ekiti:'Kwara South','Oke-Ero':'Kwara South',Moro:'Kwara North',Baruten:'Kwara North',Edu:'Kwara North',Kaiama:'Kwara North',Patigi:'Kwara North'};
const db=()=>SpreadsheetApp.openById(SPREADSHEET_ID);
const sh=n=>db().getSheetByName(n);
const props=()=>PropertiesService.getScriptProperties();
const isTrue=v=>String(v).toUpperCase()==='TRUE';
function fail(m,c){const e=new Error(m);e.code=c||'';return e;}
function secret(){let s=props().getProperty('SECRET');if(!s){s=Utilities.getUuid()+Utilities.getUuid();props().setProperty('SECRET',s);}return s;}
function table(name,headers){const s=sh(name);if(!s)throw fail('Backend sheet missing: '+name);const n=s.getLastRow();if(n<2)return[];return s.getRange(2,1,n-1,headers.length).getValues().map((r,i)=>{const o={_row:i+2};headers.forEach((k,j)=>o[k]=r[j]);return o;});}
function put(name,rows){if(!rows||!rows.length)return;const s=sh(name);const r=s.getLastRow()+1;s.getRange(r,1,rows.length,rows[0].length).setNumberFormat('@').setValues(rows);}
function audit(who,action,details){try{put(T.AUDIT,[[new Date().toISOString(),who,action,details||'']]);}catch(e){}}
const nsn=x=>{let d=String(x||'').replace(/\D/g,'');if(d.indexOf('234')===0)d=d.slice(3);else if(d[0]==='0')d=d.slice(1);return d;};
const e164=x=>{const n=nsn(x);return/^[789]\d{9}$/.test(n)?'+234'+n:null;};
const getUser=n=>table(T.USERS,UH).find(u=>String(u.username).toLowerCase()===String(n||'').trim().toLowerCase());
const pub=u=>({username:String(u.username),full_name:String(u.full_name),role:String(u.role),must_change:isTrue(u.must_change)});
function hashPw(pw,salt){let h=salt+pw;for(let i=0;i<1000;i++)h=Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,h+salt));return h;}
function makeHash(pw){const salt=Utilities.getUuid().replace(/-/g,'').slice(0,16);return salt+'$'+hashPw(pw,salt);}
function checkPw(pw,stored){const p=String(stored||'').split('$');return p.length===2&&hashPw(pw,p[0])===p[1];}
const sign=s=>Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(s,secret()));
function makeToken(u){const p=Utilities.base64EncodeWebSafe(JSON.stringify({u,exp:Date.now()+3*864e5}));return p+'.'+sign(p);}
function readToken(t){const p=String(t||'').split('.');if(p.length!==2||sign(p[0])!==p[1])throw fail('Please sign in again.','auth');const o=JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(p[0])).getDataAsString());if(o.exp<Date.now())throw fail('Session expired. Please sign in again.','auth');return o.u;}
function auth(t){const u=getUser(readToken(t));if(!u||!isTrue(u.active))throw fail('Account inactive. Contact your admin.','auth');return u;}
function login(b){const u=getUser(b.username);if(!u||!isTrue(u.active)||!checkPw(String(b.password||''),u.pw_hash))throw fail('Wrong username or password.');return{token:makeToken(u.username),user:pub(u)};}
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,service:'AMBER API'})).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){let out;const isBridge=!!(e&&e.parameter&&e.parameter.payload);const nonce=e&&e.parameter?String(e.parameter.bridge_nonce||''):'';try{const raw=isBridge?e.parameter.payload:(e&&e.postData?e.postData.contents:'{}');out={data:route(JSON.parse(raw))};}catch(err){out={error:err&&err.message?err.message:String(err),code:err&&err.code?err.code:''};}if(isBridge){const msg=JSON.stringify({__amberBridge:true,nonce,response:out}).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.top.postMessage('+msg+',"*");<\\/script></body></html>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);}
function route(b){if(!b||typeof b!=='object')throw fail('Invalid request');if(b.action==='health')return{ok:true};if(b.action==='login')return login(b);const u=auth(b.token);if(isTrue(u.must_change)&&['me','change_password'].indexOf(b.action)<0)throw fail('Change your password first.');switch(b.action){case'me':return pub(u);case'change_password':if(String(b.new_password||'').length<8)throw fail('Use at least 8 characters.');sh(T.USERS).getRange(u._row,5).setValue(makeHash(b.new_password));sh(T.USERS).getRange(u._row,6).setValue('FALSE');return{ok:true};case'settings':return{allow_not_in_directory:allowManual()};case'admin_list_users':return adminListUsers(u);case'admin_create_user':return adminCreateUser(u,b);case'admin_reset_password':return adminResetPassword(u,b);case'admin_toggle_user':return adminToggleUser(u,b);case'search':return searchContacts(b.q);case'start':return startInterview(u,b.contact_id);case'submit':return submitInterview(u,b.row);case'manual_contact':return manualContact(u,b);default:throw fail('Unknown action');}}
function requireAdmin(u){if(String(u.role).toLowerCase()!=='admin')throw fail('Admin access required.','forbidden');}
const tempPw=()=>{const a='abcdefghjkmnpqrstuvwxyz23456789';let s='';for(let i=0;i<9;i++)s+=a[Math.floor(Math.random()*a.length)];return s;};
function adminListUsers(u){requireAdmin(u);return table(T.USERS,UH).map(x=>({username:String(x.username),full_name:String(x.full_name),role:String(x.role),active:isTrue(x.active),must_change:isTrue(x.must_change),created_at:String(x.created_at||'')}));}
function adminCreateUser(u,b){requireAdmin(u);const n=String(b.full_name||'').trim(),un=String(b.username||'').trim().toLowerCase(),r=String(b.role||'enumerator').toLowerCase();if(!n)throw fail('Full name is required.');if(!/^[a-z0-9._-]{3,40}$/.test(un))throw fail('Invalid username.');if(!['admin','enumerator'].includes(r))throw fail('Invalid role.');if(getUser(un))throw fail('That username already exists.');const pw=tempPw();put(T.USERS,[[un,n,r,'TRUE',makeHash(pw),'TRUE',new Date().toISOString()]]);audit(u.username,'user_created_web',un);return{ok:true,username:un,temporary_password:pw};}
function adminResetPassword(u,b){requireAdmin(u);const t=getUser(b.username);if(!t)throw fail('User not found.');const pw=tempPw();sh(T.USERS).getRange(t._row,5).setValue(makeHash(pw));sh(T.USERS).getRange(t._row,6).setValue('TRUE');return{ok:true,username:t.username,temporary_password:pw};}
function adminToggleUser(u,b){requireAdmin(u);const t=getUser(b.username);if(!t)throw fail('User not found.');if(String(t.username).toLowerCase()===String(u.username).toLowerCase()&&isTrue(t.active))throw fail('You cannot deactivate your own account.');const on=!isTrue(t.active);sh(T.USERS).getRange(t._row,4).setValue(on?'TRUE':'FALSE');return{ok:true,username:t.username,active:on};}
const allowManual=()=>table(T.SET,['key','value']).some(r=>r.key==='allow_not_in_directory'&&isTrue(r.value));
function searchContacts(q){const d=nsn(q),s=sh(T.CONTACTS),n=s.getLastRow();if(d.length<7||n<2)return[];const vals=s.getRange(2,1,n-1,CH.length).getValues();const attempts=sh(T.ATT).getLastRow()>1?sh(T.ATT).getRange(2,2,sh(T.ATT).getLastRow()-1,1).getValues().flat():[];return vals.map((r,i)=>{const o={_row:i+2};CH.forEach((k,j)=>o[k]=r[j]);return o;}).filter(o=>nsn(o.phone_normalised).indexOf(d)>=0).slice(0,10).map(o=>({id:o.id,name:o.name,phone_normalised:o.phone_normalised,lga:o.lga,ward:o.ward,polling_unit:o.polling_unit,status:o.status,in_directory:isTrue(o.in_directory),attempts:attempts.filter(x=>x===o.id).length}));}
const findContact=id=>table(T.CONTACTS,CH).find(c=>c.id===id);
function startInterview(u,id){const c=findContact(id);if(!c)throw fail('Contact not found');if(c.status==='Completed'&&u.role!=='admin')throw fail('Interview already completed');return{contact:{id:c.id,name:c.name,phone:c.phone_normalised,lga:c.lga,ward:c.ward,polling_unit:c.polling_unit,status:c.status},server_now:new Date().toISOString()};}
function manualContact(u,b){if(!allowManual())throw fail('Interviews for numbers not in the directory are disabled.');const p=e164(b.phone);if(!p)throw fail('Invalid Nigerian phone number');if(!LGAS[b.lga]||!String(b.name||'').trim()||!String(b.ward||'').trim()||!String(b.polling_unit||'').trim())throw fail('Name, LGA, ward and polling unit are required');const id=Utilities.getUuid();put(T.CONTACTS,[[id,String(b.name).trim(),p,b.phone,b.lga,String(b.ward).trim(),String(b.polling_unit).trim(),'Not called','FALSE',new Date().toISOString()]]);return{id};}
function submitInterview(u,r){if(!r||!r.id||!r.contact_id)throw fail('Invalid submission');const c=findContact(r.contact_id);if(!c)throw fail('Contact not found');const now=new Date().toISOString();r.submitted_at=now;r.interview_date=now;r._enumerator=u.full_name;r._enum_user=u.username;r.respondent_name=c.name;r.respondent_phone=c.phone_normalised;r.respondent_lga=c.lga;r.respondent_ward=c.ward;r.respondent_polling_unit=c.polling_unit;r.vote_lga=r.s1_new_lga||c.lga;r.senate_district=LGAS[r.vote_lga]||'';const a=r.call_start?new Date(r.call_start).getTime():Date.now(),z=r.call_end?new Date(r.call_end).getTime():Date.now();r.duration_seconds=Math.max(0,Math.round((z-a)/1000));put(T.RESP,[RCOLS.map(x=>r[x[1]]==null?'':String(r[x[1]]))]);put(T.ATT,[[Utilities.getUuid(),c.id,u.username,String(r.call_start||''),String(r.call_end||''),String(r.disposition||'Completed')]]);if(c.status!=='Completed')sh(T.CONTACTS).getRange(c._row,CH.indexOf('status')+1).setValue(r.status==='complete'?'Completed':String(r.disposition||'Call back'));return{ok:true};}
function setup(){const defs=[[T.USERS,UH],[T.CONTACTS,CH],[T.RESP,RCOLS.map(x=>x[0])],[T.ATT,AH],[T.SET,['key','value']],[T.AUDIT,['time','who','action','details']],[T.STAGE,['Name','Phone number','LGA','Ward','Polling unit']],[T.ERR,['Row in Staging','Name','Phone number','LGA','Reason']],[T.UP,['time','who','mode','rows imported','rows rejected']]];defs.forEach(d=>{let s=sh(d[0]);if(!s)s=db().insertSheet(d[0]);if(s.getMaxColumns()<d[1].length)s.insertColumnsAfter(s.getMaxColumns(),d[1].length-s.getMaxColumns());if(s.getLastRow()===0)s.getRange(1,1,1,d[1].length).setValues([d[1]]).setFontWeight('bold');});secret();if(table(T.SET,['key','value']).length===0)put(T.SET,[['allow_not_in_directory','FALSE']]);}
